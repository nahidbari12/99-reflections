{
  "name": "99-reflections",
  "version": "1.0.0",
  "description": "Learn the 99 Names of Allah through flashcards and multiplayer challenges.",
  "homepage": "https://nahidbari12.github.io/99-reflections",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo-pages.mjs --metadata && vite build && node scripts/generate-seo-pages.mjs",
    "quran:generate": "node scripts/generate-quran-data.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "start": "node index.js",
    "test:seo": "node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@fontsource/amiri-quran": "^5.3.0",
    "chess.js": "^1.2.0",
    "react": "^18.2.0",
    "react-chessboard": "^4.7.3",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.2.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "quran-meta": "^6.0.17",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
