{"number":94,"nameArabic":"الشَّرح","nameEnglish":"Ash-Sharh","meaningEnglish":"The Consolation","revelationType":"Meccan","verseCount":8,"verses":[{"number":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","english":"Have We not caused thy bosom to dilate,"},{"number":2,"arabic":"وَوَضَعْنَا عَنكَ وِزْرَكَ","english":"And eased thee of the burden"},{"number":3,"arabic":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","english":"Which weighed down thy back;"},{"number":4,"arabic":"وَرَفَعْنَا لَكَ ذِكْرَكَ","english":"And exalted thy fame?"},{"number":5,"arabic":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","english":"But lo! with hardship goeth ease,"},{"number":6,"arabic":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","english":"Lo! with hardship goeth ease;"},{"number":7,"arabic":"فَإِذَا فَرَغْتَ فَٱنصَبْ","english":"So when thou art relieved, still toil"},{"number":8,"arabic":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","english":"And strive to please thy Lord."}]}
