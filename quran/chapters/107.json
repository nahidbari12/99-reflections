{"number":107,"nameArabic":"المَاعُون","nameEnglish":"Al-Maa'un","meaningEnglish":"Almsgiving","revelationType":"Meccan","verseCount":7,"verses":[{"number":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","english":"Hast thou observed him who belieth religion?"},{"number":2,"arabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","english":"That is he who repelleth the orphan,"},{"number":3,"arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","english":"And urgeth not the feeding of the needy."},{"number":4,"arabic":"فَوَيْلٌ لِّلْمُصَلِّينَ","english":"Ah, woe unto worshippers"},{"number":5,"arabic":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","english":"Who are heedless of their prayer;"},{"number":6,"arabic":"ٱلَّذِينَ هُمْ يُرَآءُونَ","english":"Who would be seen (at worship)"},{"number":7,"arabic":"وَيَمْنَعُونَ ٱلْمَاعُونَ","english":"Yet refuse small kindnesses!"}]}
